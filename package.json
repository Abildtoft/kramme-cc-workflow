{
  "name": "trackbed-installer",
  "version": "0.25.0",
  "private": true,
  "description": "Root entrypoint for npx GitHub installs",
  "license": "MIT",
  "bin": {
    "trackbed": "trackbed/scripts/convert-plugin.js"
  },
  "scripts": {
    "bootstrap:check": "bash trackbed/scripts/bootstrap-dev.sh --check",
    "bootstrap:install": "bash trackbed/scripts/bootstrap-dev.sh --install",
    "check:deps": "make -C trackbed check-deps",
    "check:pre-commit": "make -C trackbed pre-commit",
    "format:check": "make -C trackbed format-check",
    "hooks:install": "pre-commit install",
    "hooks:uninstall": "pre-commit uninstall",
    "lint-js": "make -C trackbed lint-js",
    "test": "make -C trackbed test",
    "test:node:file": "node --test",
    "test:node:watch": "make -C trackbed test-node-watch",
    "test:smoke": "make -C trackbed test-smoke",
    "verify": "make -C trackbed verify",
    "verify:pr": "make -C trackbed pr-verify"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^18.19.130",
    "esbuild": "^0.25.9",
    "node-html-parser": "7.0.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.18.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
